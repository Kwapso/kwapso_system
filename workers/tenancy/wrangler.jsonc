// The TENANCY worker — teams, memberships, and the team-database factory.
// Secrets (wrangler secret put): CF_D1_TOKEN (Account→D1→Edit API token),
// ADMIN_KEY (protects the migrate-all-teams maintenance endpoint).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-tenancy",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Only the two gateways are public — this worker is reachable only via bindings.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // SMART PLACEMENT — run this worker NEAR THE DATABASE rather than near the
  // caller. Measured on staging, 25 Aug 2026: one screen made eight team-database
  // trips at about 150ms each, because the database is in APAC and the worker ran
  // wherever the reader was. A native binding removes the API round trip; it does
  // not remove the distance.
  //
  // It is safe HERE and would not be on a gateway: this worker is reached through
  // a service binding and serves no assets, so nothing a person waits on is being
  // moved away from them. The gateway stays at the edge and crosses the world
  // ONCE, instead of once per read.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
      "migrations_dir": "../../db/core"
    }
  ],
  "services": [
    { "binding": "AUTH", "service": "kwapso-auth" },
    { "binding": "REALTIME", "service": "kwapso-realtime" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kwapso-media" }],
  // PER-CALLER RATE LIMIT (shared/workers/rate-limit.ts). The ceiling and the
  // reasoning behind the number are CALLER_REQUESTS_PER_MINUTE in
  // shared/workers/limits.ts — 600 is about ten times the busiest real person, and
  // the period must be 10 or 60 because those are the only two the binding takes.
  // Its own namespace_id per worker, so these budgets are independent: a busy
  // Tickets screen must not spend the allowance the Accounts screen needs.
  // The code FAILS OPEN if this block is missing, which is what makes it safe to
  // deploy the worker before adding the binding.
  "ratelimits": [
    { "name": "CALLER_LIMIT", "namespace_id": "1101", "simple": { "limit": 600, "period": 60 } }
  ],
  // Workers AI — one door spends it: reading a call into a proposed process map.
  "ai": { "binding": "AI" },
  "vars": {
    "AGENT_FREE_DAILY": "50",
    // WHICH ENGINE PRICED THE NIGHTLY OPS DIGEST. Tenancy makes no model
    // call — it reads the tokens agent_usage_log recorded and turns them
    // into money, which needs the rate card's name. Held to data-ops' pin by
    // no-quiet-downgrade.test.ts, which reads every wrangler config off disk.
    "AGENT_MODEL": "@cf/moonshotai/kimi-k2.6",
    "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7",
    // THE CORE DATABASE'S OWN UUID — the same id as the `DB` binding above, said
    // again because a D1 binding does not expose its id and the nightly growth
    // watch must recognise core in a listing of the whole shared account.
    // db-ownership.test.ts reads both out of this file and fails if they drift.
    "CORE_DATABASE_ID": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
    // The public web origin the SPA is served on — used for links in outbound
    // emails (invite CTA). NOT request-derived, so agent-sent invites are correct.
    "PUBLIC_APP_URL": "https://agency.kwapso.app",
    // …and the CLIENT PORTAL's origin, because one email tenancy sends goes to
    // a client rather than to us: the welcome that tells a new portal login
    // where to sign in (R30 — the recipient decides which app the link opens,
    // and neither hostname is ever spelled at a call site).
    "PUBLIC_PORTAL_URL": "https://client.kwapso.app",
    // WHO HEARS THE NIGHTLY GROWTH ALARM. Comma-separated addresses, or the one
    // word `off`. It is a VAR rather than a secret because an address is not a
    // credential, and it belongs in git for the reason ARCHITECTURE §7 gives: an
    // alarm nobody receives is a table, and the thing that turns it back into a
    // table is somebody forgetting to set this. Unset is not a crash — the cron
    // records that nobody was told (R12).
    //
    // OFF SINCE 8 SEP 2026, BY THE OWNER, ON BOTH ENVIRONMENTS. His words: "I
    // would just rather not have the error report... they do nothing but fill up
    // my inbox." The findings are read deliberately instead, through the
    // error_log_review and error_analyze skills. `off` rather than an empty
    // string precisely so the R12 check above keeps working: absence still means
    // somebody forgot, and this means somebody decided. To turn it back on, put
    // an address here — nothing else needs changing, the digest never stopped
    // being computed.
    "ALERT_TO": "off"
  },
  // Nightly 80%-size alarms (03:10 UTC) — the locked sharding machinery.
  "triggers": { "crons": ["10 3 * * *"] },
  "env": {
    "staging": {
      "name": "kwapso-tenancy-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      // SMART PLACEMENT — run this worker NEAR THE DATABASE rather than near the
      // caller. Measured on staging, 25 Aug 2026: one screen made eight team-database
      // trips at about 150ms each, because the database is in APAC and the worker ran
      // wherever the reader was. A native binding removes the API round trip; it does
      // not remove the distance.
      //
      // It is safe HERE and would not be on a gateway: this worker is reached through
      // a service binding and serves no assets, so nothing a person waits on is being
      // moved away from them. The gateway stays at the edge and crosses the world
      // ONCE, instead of once per read.
      "placement": { "mode": "smart" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
          "migrations_dir": "../../db/core"
        },
        {
          // THE TEAM DATABASE, REACHED DIRECTLY. See `natives` in
          // shared/workers/d1-rest.ts: the REST door costs ~400ms a statement
          // for SQL that runs in ~1ms, and this is the same database over the
          // data plane. The `_ID` var below is not a duplicate — the data door
          // routes by database id and a binding cannot be asked its own.
          "binding": "TEAM_DB_0",
          "database_name": "team-01kzwxfd86n0k3rzrbhkmkrwys",
          "database_id": "727537f7-653d-4114-af23-332d1aae0f90"
        }
      ],
      "services": [
        { "binding": "AUTH", "service": "kwapso-auth-staging" },
        { "binding": "REALTIME", "service": "kwapso-realtime-staging" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kwapso-media-staging" }],
      "ratelimits": [
        { "name": "CALLER_LIMIT", "namespace_id": "1101", "simple": { "limit": 600, "period": 60 } }
      ],
      "ai": { "binding": "AI" },
      "vars": {
        "AGENT_FREE_DAILY": "2000",
        // WHICH ENGINE PRICED THE NIGHTLY OPS DIGEST. Tenancy makes no model
        // call — it reads the tokens agent_usage_log recorded and turns them
        // into money, which needs the rate card's name. Held to data-ops' pin by
        // no-quiet-downgrade.test.ts, which reads every wrangler config off disk.
        "AGENT_MODEL": "@cf/moonshotai/kimi-k2.6",
        // "true" like content + data-ops: ONE allowance, ONE height — staging
        // never refuses for running out (the counters still record).
        "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
        "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7",
        "TEAM_DB_0_ID": "727537f7-653d-4114-af23-332d1aae0f90",
        // Staging's own core, for the growth watch. See the production note.
        "CORE_DATABASE_ID": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
        // The public staging web origin — used for invite-email links.
        "PUBLIC_APP_URL": "https://agency-staging.kwapso.app",
        // The staging portal, for the same one email.
        "PUBLIC_PORTAL_URL": "https://staging-client.kwapso.app",
        // Staging followed production to `off` on 8 Sep 2026. The old reason for
        // keeping staging loud — that a broken alarm path should be discovered
        // here — died with the mail itself: there is no delivery path left to
        // break on either environment, and while there was one, staging and
        // production sent the SAME subject line, so the owner received two
        // indistinguishable copies of every night. Turning one back on means
        // turning the other on too, and giving them different subjects first.
        "ALERT_TO": "off"
      },
      "triggers": { "crons": ["10 3 * * *"] }
    }
  }
}
