// The CONTENT worker — team-DB content modules (Learning, Tickets, Knowledge).
// Secrets (wrangler secret put): CF_D1_TOKEN (Account→D1→Edit API token) so it
// can reach per-team databases over the one REST door.
//
// The AI binding does TWO jobs here: the knowledge base's EMBEDDING model, and the
// cheap model that WRITES an answer out of the passages a question found (R23,
// lib/knowledge-compose.ts). Only the second one costs the team anything, so only
// the second one is gated on the `agent` module and metered — see AGENT_FREE_DAILY
// in the vars below. The Vectorize binding is where those embeddings are searched. The cron is the module's BACKSTOP sweep — a write
// re-indexes what it touched immediately, so the cron's job is only to notice
// what nobody was there to tell us about. Bounded per tick, resumable from a
// cursor, and it records its failures (R12).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwapso-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Only the two gateways are public — this worker is reachable only via bindings.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // SMART PLACEMENT — run this worker NEAR THE DATABASE rather than near the
  // caller. Measured on staging, 25 Aug 2026: one screen made eight team-database
  // trips at about 150ms each, because the database is in APAC and the worker ran
  // wherever the reader was. A native binding removes the API round trip; it does
  // not remove the distance.
  //
  // It is safe HERE and would not be on a gateway: this worker is reached through
  // a service binding and serves no assets, so nothing a person waits on is being
  // moved away from them. The gateway stays at the edge and crosses the world
  // ONCE, instead of once per read.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwapso-core",
      "database_id": "e55a2c0f-346a-4056-b01c-7869a8b253dc",
      "migrations_dir": "../../db/core"
    }
  ],
  "services": [
    { "binding": "AUTH", "service": "kwapso-auth" },
    { "binding": "REALTIME", "service": "kwapso-realtime" }
  ],
  "r2_buckets": [
    { "binding": "LEARNING_MEDIA", "bucket_name": "kwapso-learning-media" },
    { "binding": "HELP_MEDIA", "bucket_name": "kwapso-help-media" },
    // Shared with both gateways — the one bucket a CLIENT can both write to (a
    // to-do's attachment) and read back (`/media/*` is served by the portal door
    // as well as the agency one).
    { "binding": "MEDIA", "bucket_name": "kwapso-media" },
    { "binding": "INTERNAL_MEDIA", "bucket_name": "kwapso-internal-media" }
  ],
  "ai": { "binding": "AI" },
  // THE KNOWLEDGE BASE'S VECTOR INDEX. One index for the account; each team is a
  // NAMESPACE inside it, which Vectorize applies before the search — so a query
  // cannot see another team's vectors even if every metadata filter were wrong.
  // Created by hand once (BOOTSTRAP.md) with its nine metadata indexes BEFORE
  // anything is ingested: Vectorize will not index metadata retrospectively.
  "vectorize": [{ "binding": "KNOWLEDGE_INDEX", "index_name": "kwapso-knowledge" }],
  // PER-CALLER RATE LIMIT (shared/workers/rate-limit.ts). The ceiling and the
  // reasoning behind the number are CALLER_REQUESTS_PER_MINUTE in
  // shared/workers/limits.ts — 600 is about ten times the busiest real person, and
  // the period must be 10 or 60 because those are the only two the binding takes.
  // Its own namespace_id per worker, so these budgets are independent: a busy
  // Tickets screen must not spend the allowance the Accounts screen needs.
  // The code FAILS OPEN if this block is missing, which is what makes it safe to
  // deploy the worker before adding the binding.
  "ratelimits": [
    { "name": "CALLER_LIMIT", "namespace_id": "1102", "simple": { "limit": 600, "period": 60 } }
  ],
  // AGENT_FREE_DAILY is the TEAM'S ONE AI allowance, and it is here because this
  // worker spends it too — writing out the answer a question found (R23). It must
  // match data-ops' and tenancy's values exactly; credits-invariant.test.ts
  // compares all three, because one allowance enforced at three different heights
  // is a bug nobody sees until somebody runs out twice.
  //
  // AGENT_NO_DAILY_CAP IS GONE FROM STAGING (2026-09-06). It did not raise the
  // ceiling, it removed it, and staging is no longer one person trying a screen —
  // so a looping client could have spent the account to zero with the meter
  // measuring happily and nothing able to say no. Staging now carries a real
  // number that is simply high: 2,000 a team a day, about forty times a heavy
  // testing day and about $69 at COSTS.md's per-step price. The reasoning, the
  // arithmetic and what would change our mind are in credits-invariant.test.ts.
  //
  // THE TWO FRONT DOORS, AS CONFIGURATION. This worker's emails link a staff
  // member into the agency app and a CLIENT into the portal, and neither hostname
  // may be spelled at a call site (shared/workers/record-link.ts).
  // client.kwapso.app is the portal; portal.kwapso.app is the owner's live
  // third-party product and must never appear here.
  "vars": {
    "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7",
    // THE BUCKET NAMES, BESIDE THEIR BINDINGS — the pair a presigned upload
    // needs, and the same shape as `TEAM_DB_<n>_ID` beside its D1 binding: a
    // binding cannot be asked its own bucket name at runtime, and an S3
    // presign has to put that name in the signed path. Inert until
    // `R2_ACCESS_KEY_ID` is set as a secret; with no credential every upload
    // door takes the byte-through-the-worker path it takes today.
    "MEDIA_BUCKET": "kwapso-media",
    "INTERNAL_MEDIA_BUCKET": "kwapso-internal-media",
    "PUBLIC_APP_URL": "https://agency.kwapso.app",
    "PUBLIC_PORTAL_URL": "https://client.kwapso.app",
    "AGENT_FREE_DAILY": "50",
    "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  // The knowledge sweep. Fifteen minutes is the backstop §3 names ("push where
  // the source supports it, with a 15-minute sweep as the backstop"); a tick
  // whose sources have not changed costs three reads per team and no model call.
  "triggers": { "crons": ["*/15 * * * *", "0 7 * * *"] },
  "env": {
    "staging": {
      "name": "kwapso-content-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      // SMART PLACEMENT — run this worker NEAR THE DATABASE rather than near the
      // caller. Measured on staging, 25 Aug 2026: one screen made eight team-database
      // trips at about 150ms each, because the database is in APAC and the worker ran
      // wherever the reader was. A native binding removes the API round trip; it does
      // not remove the distance.
      //
      // It is safe HERE and would not be on a gateway: this worker is reached through
      // a service binding and serves no assets, so nothing a person waits on is being
      // moved away from them. The gateway stays at the edge and crosses the world
      // ONCE, instead of once per read.
      "placement": { "mode": "smart" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kwapso-core-staging",
          "database_id": "1df02340-fc91-4cac-8ccb-d19528dcd9f7",
          "migrations_dir": "../../db/core"
        },
        {
          // THE TEAM DATABASE, REACHED DIRECTLY. See `natives` in
          // shared/workers/d1-rest.ts: the REST door costs ~400ms a statement
          // for SQL that runs in ~1ms, and this is the same database over the
          // data plane. The `_ID` var below is not a duplicate — the data door
          // routes by database id and a binding cannot be asked its own.
          "binding": "TEAM_DB_0",
          "database_name": "team-01kzwxfd86n0k3rzrbhkmkrwys",
          "database_id": "727537f7-653d-4114-af23-332d1aae0f90"
        }
      ],
      "services": [
        { "binding": "AUTH", "service": "kwapso-auth-staging" },
        { "binding": "REALTIME", "service": "kwapso-realtime-staging" }
      ],
      "r2_buckets": [
        { "binding": "LEARNING_MEDIA", "bucket_name": "kwapso-learning-media-staging" },
        { "binding": "HELP_MEDIA", "bucket_name": "kwapso-help-media-staging" },
        { "binding": "MEDIA", "bucket_name": "kwapso-media-staging" },
        { "binding": "INTERNAL_MEDIA", "bucket_name": "kwapso-internal-media-staging" }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "KNOWLEDGE_INDEX", "index_name": "kwapso-knowledge-staging" }],
      "triggers": { "crons": ["*/15 * * * *", "0 7 * * *"] },
      "ratelimits": [
        { "name": "CALLER_LIMIT", "namespace_id": "1102", "simple": { "limit": 600, "period": 60 } }
      ],
      "vars": {
        "CF_ACCOUNT_ID": "b5bb3d84a59c029ea5e0fe164dab1cf7",
        "TEAM_DB_0_ID": "727537f7-653d-4114-af23-332d1aae0f90",
        // The staging twins — see the production note above.
        "MEDIA_BUCKET": "kwapso-media-staging",
        "INTERNAL_MEDIA_BUCKET": "kwapso-internal-media-staging",
        "PUBLIC_APP_URL": "https://agency-staging.kwapso.app",
        "PUBLIC_PORTAL_URL": "https://staging-client.kwapso.app",
        "AGENT_FREE_DAILY": "2000",
        "WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
      }
    }
  }
}
